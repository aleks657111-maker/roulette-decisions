{
  "permissions": {
    "allow": [
      "Bash(find \"/c/Users/Пользователь\" -maxdepth 4 -iname \"*проект*два*\" -o -iname \"*workspace*\" 2>/dev/null | grep -vi \"AppData\\\\|node_modules\")",
      "Read(//c/Users/Пользователь/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"C:\\\\Users\\\\Пользователь\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" ] || \"C:\\\\Users\\\\Пользователь\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"C:\\\\Users\\\\Пользователь\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" ] || \"C:\\\\Users\\\\Пользователь\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  },
  "description": "Impeccable design detector: immediate-tier checks after Edit/Write on UI files, full-rule deep pass on Stop."
}
